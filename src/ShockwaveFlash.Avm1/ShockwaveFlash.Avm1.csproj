<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ShockwaveFlash.Avm1</PackageId>
    <Description>AVM1 (ActionScript 1/2 bytecode) decoder, encoder and data evaluator for the ShockwaveFlash SWF library. Disassemble DoAction bytecode to a typed action model, evaluate data scripts to a value tree, and write edits back.</Description>
    <PackageTags>swf;shockwave;flash;avm1;actionscript;bytecode;disassembler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShockwaveFlash.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShockwaveFlash\ShockwaveFlash.csproj" />
    <ProjectReference Include="..\ShockwaveFlash.SourceGenerators\ShockwaveFlash.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ShockwaveFlash.SourceGenerators\bin\$(Configuration)\netstandard2.0\ShockwaveFlash.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ShockwaveFlash.IO.Binary" />
  </ItemGroup>

</Project>
