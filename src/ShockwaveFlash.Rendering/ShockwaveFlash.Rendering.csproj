<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ShockwaveFlash.Rendering</PackageId>
    <Description>Render SWF characters (shapes, sprites, timelines, images) parsed by ShockwaveFlash to SVG and to raster images (PNG/JPEG/WebP/GIF) through a native, cross-platform Skia backend.</Description>
    <PackageTags>swf;shockwave;flash;rendering;render;svg;skia;raster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShockwaveFlash\ShockwaveFlash.csproj" />
  </ItemGroup>

</Project>
