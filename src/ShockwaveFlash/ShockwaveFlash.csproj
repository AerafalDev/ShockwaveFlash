<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ShockwaveFlash</PackageId>
    <Description>A fast, allocation-light reader and writer for the SWF (Shockwave Flash) binary format. Disassemble a .swf into a strongly-typed, mutable tag tree and assemble it back losslessly.</Description>
    <PackageTags>swf;shockwave;flash;adobe;flash-player;binary;parser;serialization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShockwaveFlash.Avm1" />
    <InternalsVisibleTo Include="ShockwaveFlash.Rendering" />
    <InternalsVisibleTo Include="ShockwaveFlash.Tests" />
  </ItemGroup>

</Project>
